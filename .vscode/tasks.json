{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build raylib C",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
            "-g",
            "-std=gnu23",
            "${workspaceFolder}/src/*.c",
            "-o",
            "${workspaceFolder}/ClikR.exe",
            "-I",
            "${workspaceFolder}/include",
            "-I",
            "C:/raylib/raylib/src",
            "-L",
            "C:/raylib/raylib/src",
            "-lraylib",
            "-lopengl32",
            "-lgdi32",
            "-lwinmm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}