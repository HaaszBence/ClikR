{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build raylib C",
            "command": "/usr/bin/gcc",
            "args": [
                "-g",
                "-std=gnu23",
                "${workspaceFolder}/src/*.c",
                "-o",
                "${workspaceFolder}/ClikR",
                "-I",
                "${workspaceFolder}/include",
                "-lraylib",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
